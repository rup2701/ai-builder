import assert from "node:assert/strict";
import { planChange, sectionsOf } from "../src/lib/agents/change-planner";
const ctx = { siteName: "Ledgerline", sections: sectionsOf({ blocks: [{ type: "hero" }, { type: "steps" }] }) };
assert.equal(ctx.sections.length, 2);
const u = { inputTokens: 1, outputTokens: 1, costUsd: 0 };
const good = await planChange(async () => ({ input: { title: "Tighter code and lighter step numbers", changes: ["Code lines closer together (line height 1.2)", "Step number circles light gray, dark text"], instruction: "In How it works, set the JSON line-height to 1.2. Make the step circles light gray with dark text, contrast at least 4.5 to 1." }, usage: u }), "x", ctx);
assert.equal(good.plan?.changes?.length, 2);
const bad = await planChange(async () => ({ input: { title: "t" }, usage: u }), "x", ctx);
assert.equal(bad.plan, null);
const err = await planChange(async () => { throw new Error("down"); }, "x", ctx);
assert.equal(err.plan, null); assert.equal(err.usage, null);
const dec = await planChange(async () => ({ input: { decline: "Sign-in cannot be changed here." }, usage: u }), "x", ctx);
assert.equal(dec.plan?.decline, "Sign-in cannot be changed here.");
console.log("change-planner ok");
const sm = await planChange(async () => ({ input: { title: "New headline text", changes: ["Hero headline now reads Stop writing parsers"], instruction: "Change the hero headline text to Stop writing parsers.", size: "small" }, usage: u }), "x", ctx);
assert.equal(sm.plan?.size, "small");
const noSize = await planChange(async () => ({ input: { title: "New headline text", changes: ["Hero headline now reads Stop writing parsers"], instruction: "Change the hero headline text to Stop writing parsers." }, usage: u }), "x", ctx);
assert.equal(noSize.plan?.size, undefined); // missing size is treated as substantial by the caller
console.log("size ok");
let seen = "";
await planChange(async (req) => { seen = req.system; return { input: { decline: "That is already live: Tighter JSON. Nothing to change." }, usage: u }; }, "x", { ...ctx, applied: ["Tighter JSON and gray step numbers: line height 1.2"] });
assert.ok(seen.includes("already made and live") && seen.includes("Tighter JSON and gray step numbers"));
await planChange(async (req) => { seen = req.system; return { input: { decline: "That is already live: x." }, usage: u }; }, "x", ctx);
assert.ok(seen.includes("No changes have been made"));
console.log("applied ok");
import { pageContentOf } from "../src/lib/agents/change-planner";
assert.equal(pageContentOf(null), "");
assert.ok(pageContentOf({ blocks: [{ type: "pricing", plans: [{ name: "Starter", price: "$49" }] }] }).includes("Starter"));
assert.ok(pageContentOf({ blocks: [{ x: "y".repeat(5000) }] }, 100).length < 110);
let sys = "";
await planChange(async (req) => { sys = req.system; return { input: { decline: "x ok" }, usage: u }; }, "x", { ...ctx, content: '{"type":"pricing","plans":[{"name":"Starter","price":"$49"}]}' });
assert.ok(sys.includes('"price":"$49"') && sys.includes("may be a little behind"));
console.log("content ok");

const ans = await planChange(async () => ({ input: { answer: "That card is large on purpose: it is the big card in the benefits grid. Nothing was changed. Tell me if you want it the same size as the others." }, usage: u }), "why is this title bigger?", ctx);
assert.ok(ans.plan?.answer?.includes("Nothing was changed") && !ans.plan?.title);
let qsys = ""; await planChange(async (req) => { qsys = req.system; return { input: { answer: "Three plans." }, usage: u }; }, "how many plans?", ctx);
assert.ok(qsys.includes('set "answer"'));
console.log("answer ok");

await planChange(async (req) => { seen = req.system; return { input: { decline: "That is already live: x." }, usage: u }; }, "x", ctx);
assert.ok(seen.includes("Plain slips in the owner's text are fixed") && seen.includes("inside quotation marks stay exactly as typed"));
console.log("slips ok");
