    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "geist": "^1.5.1",
    "next": "16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
