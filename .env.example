# Database: local Postgres or Neon
DATABASE_URL=postgres://postgres:postgres@localhost:5432/appnomics_builder

# Auth.js
AUTH_SECRET=            # openssl rand -base64 32
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Only these emails can sign in (comma separated)
ALLOWED_EMAILS=you@example.com
# Local development only: shows an email-only sign-in form. Never set in production.
ALLOW_DEV_LOGIN=1

# Model (used when the interviewer moves from rules to the model)
ANTHROPIC_API_KEY=
# Only for organization-wide keys: the workspace to bill and log this app under
# ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=

# Publishing. "stub" records what would happen; "live" calls the APIs.
INTEGRATIONS=stub
GITHUB_ORG=
GITHUB_TOKEN=
GITHUB_TEMPLATE_REPO=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
NEON_API_KEY=

# Optional: force the rule interviewer even when a key is set
# INTERVIEWER=rules
# Optional: per-million-token prices so cost is logged (check Anthropic pricing)
# ANTHROPIC_PRICE_IN_PER_MTOK=
# ANTHROPIC_PRICE_OUT_PER_MTOK=

# ---- Added 14 Nov 2026: everything else the code reads (names only; real values live in Vercel and Fly) ----
# Which website kinds the web app offers
# ENABLE_SHOWCASE_PACK=1
# ENABLE_LOCAL_PACK=1
# ENABLE_LOCAL_BUILD=1
# Per-person limits
# SITE_BUILD_LIMIT=2
# SITE_BUILD_LIMIT_EXEMPT=you@example.com
# SITE_IMPORT_LIMIT_PER_HOUR=
# Cheaper model for reading a website (optional)
# ANTHROPIC_IMPORT_MODEL=
# Email through Resend: build emails and (restaurant sites) table request emails
# RESEND_API_KEY=
# EMAIL_FROM=Name <hello@your-verified-domain>
# ADMIN_NOTIFY_EMAIL=you@example.com
# Salt for hashing visitors in the table request endpoint
# RESERVE_HASH_SALT=
# Worker only (set on Fly, not Vercel). WORKER_SITE_MODE=real runs real builds; unset runs the stub.
# WORKER_SITE_MODE=real
# WORKER_BUILD_MAX_USD=8
# WORKER_RESTAURANT_ADMIN=off     # switches off the owner area added after a restaurant site is live
# RUNNER_DIR=../appnomics-runner
# VERCEL_SCOPE=
# NEON_ORG_ID=
